# Desenvolvimento local: use o proxy do Vite para evitar CORS.
# Este valor relativo so funciona quando o app roda pelo dev server do Vite.
VITE_DENTAL_AURA_API_BASE_URL=/webhook
VITE_DENTAL_AURA_N8N_PROXY_TARGET=https://seu-n8n.example.com

# Producao/Lovable: aponte direto para a URL publica do n8n e configure CORS no n8n/proxy.
# Nao use /webhook relativo em deploy estatico, pois ele chama o proprio frontend.
# VITE_DENTAL_AURA_API_BASE_URL=https://yt-n8n.ftr0hc.easypanel.host/webhook
